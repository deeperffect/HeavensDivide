float3 c=pow(max(SourceColor,0.000001),1.0/2.2);
float3 d=pow(max(FabricColor,0.000001),1.0/2.2);
float v=max(c.r,max(c.g,c.b));
float sat=(v-min(c.r,min(c.g,c.b)))/max(v,0.00001);
float3 p=LocalPosition/100.0;
float shoulders=smoothstep(0.12,0.17,abs(p.x))*smoothstep(0.50,0.54,p.z)*(1.0-smoothstep(0.75,0.79,p.z));
float muzzle=(1.0-smoothstep(0.092,0.112,abs(p.x)))*smoothstep(0.61,0.635,p.z)*(1.0-smoothstep(0.775,0.8,p.z))*smoothstep(0.10,0.13,p.y);
float warmHue=smoothstep(0.07,0.16,d.r-d.g)*smoothstep(0.035,0.09,d.g-d.b);
float warm=max(shoulders,muzzle)*warmHue;
float mauve=smoothstep(0.07,0.16,d.r-d.g)*(1.0-smoothstep(0.02,0.07,d.g-d.b))*(1.0-warm);
float green=max(0.0,1.0-mauve-warm);
float pale=smoothstep(0.28,0.48,v);
float3 warmColor=lerp(float3(1.0,0.62,0.32),float3(1.0,0.88,0.66),pale);
float3 result=v*(green*1.45*float3(0.50,0.93,1.0)+mauve*1.35*float3(1.0,0.58,0.68)+warm*1.58*warmColor);
float detail=lerp(1.0,clamp(dot(d,float3(0.2126,0.7152,0.0722))/max(v,0.05),0.85,1.15),0.18);
result*=detail;
float protect=max(1.0-smoothstep(0.07,0.16,v),smoothstep(0.64,0.85,v)*(1.0-smoothstep(0.25,0.55,sat)));
result=lerp(result,c,protect);
return pow(saturate(result),2.2);